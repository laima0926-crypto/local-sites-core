---
import type { SiteConfig } from '../schema';
import '../styles/skins.css';
interface Props {
  site: SiteConfig;
  title?: string;
  description?: string;
  pathname?: string;
  image?: string;
}
const { site, title, description, pathname = Astro.url.pathname, image } = Astro.props;

const pageTitle = title
  ? `${title} | ${site.business.name}`
  : site.business.tagline
    ? `${site.business.name} | ${site.business.tagline}`
    : site.business.name;
const pageDescription = description || site.business.shortDescription;
// Prefer the client's own domain (site.url) for canonical/og:url, then Astro.site,
// then a placeholder. Without this, every client self-canonicalises to example.co.uk.
const siteOrigin = site.url || Astro.site?.toString() || 'https://example.co.uk';
const canonical = new URL(pathname, siteOrigin).toString();
// Social-preview image: prefer an explicit one, else the hero photo, else the
// logo — made absolute. If there's nothing real, omit the tags (no 404; there
// is no bundled og-default).
const rawOgImage = image || site.business.heroImage || site.business.logo || '';
const ogImage = rawOgImage
  ? (/^https?:\/\//i.test(rawOgImage) ? rawOgImage : new URL(rawOgImage, siteOrigin).toString())
  : '';

// Brand colour scale → CSS variables, ONLY when the client has a theme. Each
// template's tailwind config carries its own colour as the var() fallback, so a
// site with no theme keeps the template's default palette (no regression).
const brandVars = Object.entries(site.theme?.brand ?? {}).map(([k, v]) => `--brand-${k}:${v}`).join(';');

// STRUCTURED DATA MUST NOT BE ABLE TO END ITS OWN SCRIPT TAG.
//
// This block is written with set:html, which inserts the string raw, and it is
// built from the customer's own words: business name, tagline, description,
// address. JSON.stringify escapes JSON syntax. It does NOT escape "</script>",
// so a business name containing one closed this tag and everything after it
// became live markup.
//
// Proved in a real browser on 2026-08-06 with an order placed through the
// normal form: the injected script ran, and two script elements it created were
// sitting in the finished page. A customer's live website could have been
// defaced or pointed at a phishing page by whoever typed the order.
//
// Escaping "<" is enough and is safe: < is a valid JSON string escape, so
// any parser reads exactly the same data back. "&" and ">" go too, which is the
// usual belt-and-braces for JSON embedded in HTML.
function jsonLd(value: unknown): string {
  return JSON.stringify(value)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026');
}

// --- Readable text on the customer's own brand colour ------------------------
//
// The shared components write white text on brand-500/600/700: every button,
// the header call button, the testimonials band, the closing banner. White only
// reads when the brand colour is dark, and customers pick their own colour from
// a picker. Measured on live client sites, white text was landing at 2.5:1,
// 3.4:1 and 3.7:1 against a 4.5:1 bar — a grey, an olive and a teal.
//
// Darkening the colour is not the lever. Pushed far enough to carry white text
// a yellow turns olive, costs the customer their colour, and STILL only reaches
// 3.3:1. Black on their original yellow reaches 6.4:1. So the colour stays and
// the ink moves.
//
// WHY THIS IS A SCRIPT AND NOT A STYLESHEET
// The obvious version was pure CSS keyed on the class: `.bg-brand-600` gets the
// ink the generator computed for brand-600. It was tried, measured, and thrown
// away, because on most designs the class name does not describe the colour on
// screen. template-flexible repaints `.bg-brand-600` to near-black for its
// testimonials band; the bespoke skins repaint more than that. Inking those by
// class put black text on a near-black band and took one page from two contrast
// failures to fifteen. Every styled design would have been damaged the same way.
//
// So the class is used only to decide WHERE to look — these are the components
// that carry brand colour, as opposed to a hero sitting on a photograph — and
// the ink is chosen from the colour actually painted, read back from the
// browser. A design that repaints the band dark measures dark and keeps its
// white text untouched.
//
// It also only acts on text that is FAILING right now. A band that already
// reads well is left exactly as its designer built it, tint hierarchy and all.
//
// HOW `painted()` DECIDES WHAT IS BEHIND SOMETHING
// It walks up the ancestors collecting every background layer, then composites
// them back down. The compositing matters: a header at 90% opacity over a
// different colour is a real case here, and an earlier version that simply
// skipped any layer under 95% opaque read straight through a gold header to the
// raspberry body behind it, decided white text was fine, and left a whole
// navigation unreadable while reporting a clean pass.
//
// It returns null the moment it meets a background IMAGE (a photo, a gradient,
// a video poster), because there is no single colour behind that text, and
// guessing one is how you end up blacking out a hero.
//
// Runs on themed sites only, so unthemed demos and the templates' own default
// palettes never execute it. Inline and last in the body: no network request,
// and it runs before first paint. Note that everything inside the string below
// is shipped to the visitor, comments included, so the explanation lives out
// here where it costs them nothing.
const BRAND_INK_JS = `
(function () {
  var W = [255, 255, 255], K = [0, 0, 0];
  function chan(s) {
    var m = String(s).match(/rgba?\\(([^)]+)\\)/);
    if (!m) return null;
    var p = m[1].split(/[,\\/\\s]+/).filter(Boolean).map(Number);
    return { rgb: p.slice(0, 3), a: p.length > 3 ? p[3] : 1 };
  }
  function lum(c) {
    var a = c.map(function (v) { v = v / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); });
    return 0.2126 * a[0] + 0.7152 * a[1] + 0.0722 * a[2];
  }
  function ratio(a, b) {
    var x = lum(a), y = lum(b), hi = Math.max(x, y), lo = Math.min(x, y);
    return (hi + 0.05) / (lo + 0.05);
  }
  function flatten(fg, bg, a) {
    return fg.map(function (v, i) { return Math.round(v * a + bg[i] * (1 - a)); });
  }
  // The colour actually painted behind an element. Composites translucent
  // layers; returns null on a background image. See the note above this string
  // for why both of those matter. (Comments in here ship to every visitor, so
  // they stay short, and they carry no em dashes: house copy rule.)
  function painted(el) {
    var stack = [];
    function settle(base) {
      for (var i = stack.length - 1; i >= 0; i--) base = flatten(stack[i].rgb, base, stack[i].a);
      return base;
    }
    for (var n = el; n && n.nodeType === 1; n = n.parentElement) {
      var cs = getComputedStyle(n);
      if (cs.backgroundImage && cs.backgroundImage !== 'none') return null;
      var c = chan(cs.backgroundColor);
      if (!c || c.a === 0) continue;
      if (c.a >= 0.999) return settle(c.rgb);
      stack.push(c);
    }
    return settle(W);
  }
  var hosts = document.querySelectorAll('[class*="bg-brand-"]');
  Array.prototype.forEach.call(hosts, function (host) {
    if (!painted(host)) return; // host sits on an image: nothing reliable to measure
    // The host itself plus everything under it that carries its own text.
    var els = [host].concat(Array.prototype.slice.call(host.querySelectorAll('*')));
    els.forEach(function (el) {
      var own = '';
      for (var i = 0; i < el.childNodes.length; i++) {
        if (el.childNodes[i].nodeType === 3) own += el.childNodes[i].textContent;
      }
      if (!own.trim()) return;
      var cs = getComputedStyle(el);
      if (cs.visibility === 'hidden' || cs.display === 'none') return;
      // Re-measure per element: a white card can sit inside a brand band.
      var here = painted(el);
      if (!here) return;
      var f = chan(cs.color);
      if (!f) return;
      var fg = f.a < 1 ? flatten(f.rgb, here, f.a) : f.rgb;
      var size = parseFloat(cs.fontSize), bold = parseInt(cs.fontWeight, 10) >= 700;
      var bar = (size >= 24 || (size >= 18.66 && bold)) ? 3 : 4.5;
      if (ratio(fg, here) >= bar) return; // already readable: leave the design alone
      var best = ratio(here, W) >= ratio(here, K) ? W : K;
      el.style.color = 'rgb(' + best.join(',') + ')';
    });
  });
  // NOTE ON GRADIENTS. Text sitting on a gradient is skipped above, because
  // there is no single colour behind it to measure. A special case for the
  // gradient button in core's own Hero was written, then removed: none of the
  // templates render that button (each has its own hero), so the only thing the
  // rule ever matched was a decorative full-bleed background wash, which it
  // flattened. If a template ever does put text on a brand gradient, it needs
  // handling here deliberately rather than by a catch-all.
})();`;
// A CLIENT SITE MUST USE THE FONTS OF THE DESIGN IT WAS BUILT ON.
//
// The generator does not write theme.fontsHref, so every client site fell back
// to the generic pair that used to sit here. The design's stylesheet still
// asked for its real typeface (Archivo on the garage look, Fraunces on the
// gardener), that typeface was never loaded, and the headings quietly rendered
// in a system fallback. The customer chose a look and did not get it.
// Found 2026-08-06 by putting a demo and a real build side by side.
//
// Every design now ships /fonts/fonts.css in its own public/ folder, and
// new-client.sh copies public/ into the client site, so the same path is right
// in both places. The fallback is local too: nothing here reaches out.
const fontsHref = site.theme?.fontsHref || '/fonts/fonts.css';
const skinClass = site.theme?.style ? ` skin-${site.theme.style}` : '';

// The address as a search engine wants it: each part labelled.
//
// THE BUG THIS REPLACES
// It used to be `addressLines[0].split(',')[0]` reported as the town. That is
// only ever right by luck. "Lichfield, Staffordshire" gives Lichfield; but
// "28 Bore Street, Lichfield, WS13 6LL" told Google the town was
// "28 Bore Street", and "Tamworth Street, Lichfield, Staffordshire" told it
// "Tamworth Street". Two of the demo sites were doing exactly that.
//
// No cleverer comma-counting can fix it, because sites write the line
// differently. So the parts are used when the site actually has them, and the
// old guess is kept only as a fallback for sites that predate them.
const mainLocation = site.contact.locations?.[0];
const postalAddress = mainLocation
  ? {
      '@type': 'PostalAddress',
      ...(mainLocation.line1 || mainLocation.line2
        ? { streetAddress: [mainLocation.line1, mainLocation.line2].filter(Boolean).join(', ') }
        : {}),
      ...(mainLocation.town ? { addressLocality: mainLocation.town } : {}),
      ...(mainLocation.county ? { addressRegion: mainLocation.county } : {}),
      ...(mainLocation.postcode ? { postalCode: mainLocation.postcode } : {}),
      addressCountry: 'GB',
    }
  : {
      '@type': 'PostalAddress',
      addressLocality: site.contact.addressLines[0]?.split(',')[0],
      addressCountry: 'GB',
    };

const SCHEMA_TYPE: Record<string, string> = {
  cleaning: 'LocalBusiness',
  gardener: 'LocalBusiness',
  pet: 'LocalBusiness',
  restaurant: 'Restaurant',
  repair: 'LocalBusiness',
  trades: 'HomeAndConstructionBusiness',
  creative: 'ProfessionalService',
  // Flexible covers any local business, so the broadest type is the honest one.
  flexible: 'LocalBusiness',
  // schema.org has a dedicated type for garages. Use it rather than the generic
  // LocalBusiness so search engines read the demo correctly.
  automotive: 'AutoRepair',
};
const schemaType = SCHEMA_TYPE[site.businessType] || 'LocalBusiness';

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: site.business.name,
  description: site.business.shortDescription,
  // No telephone/email here on purpose: JSON-LD is plain text in the HTML and
  // a prime target for spam harvesters. Google gets NAP data from the
  // Business Profile instead; the site shows the number via the obfuscated
  // client-side renderer (see ../obfuscate.ts).
  url: siteOrigin,
  areaServed: site.contact.nationwide
    ? { '@type': 'Country', name: 'United Kingdom' }
    : site.contact.serviceAreas.map((area) => ({ '@type': 'City', name: area })),
  address: postalAddress,
  ...(site.socials.facebook || site.socials.instagram || site.socials.googleBusinessProfile
    ? {
        sameAs: [site.socials.facebook, site.socials.instagram, site.socials.googleBusinessProfile].filter(Boolean),
      }
    : {}),
  ...(site.businessType === 'restaurant'
    ? {
        ...(site.cuisine ? { servesCuisine: site.cuisine } : {}),
        ...(site.reservationUrl ? { acceptsReservations: site.reservationUrl } : {}),
      }
    : {}),
};
---

<!doctype html>
<html lang="en-GB" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {brandVars && <style set:html={`:root{${brandVars}}`}></style>}
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {/* Fonts are served from this site, not from Google. Every visitor used to
        have their IP address and browser details sent to fonts.googleapis.com,
        while the privacy page we generate told them, in the customer's own
        name, that nothing on the site tracks them. Found 2026-08-06.
        The preconnects went with it: there is nothing to connect to.
        ./selfhost-fonts.sh downloads each design's typefaces into its own
        public/fonts/, and new-client.sh copies that into every client site. */}
    <link href={fontsHref} rel="stylesheet" />

    <script type="application/ld+json" set:html={jsonLd(localBusiness)} />

    <!-- Scroll-reveal: opt in only when motion is allowed + supported (set in <head> to avoid flash) -->
    <script is:inline>
      (function () {
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
          document.documentElement.classList.add('reveal-on');
        } catch (e) {}
      })();
    </script>
    <style is:global>
      @media (prefers-reduced-motion: no-preference) {
        html.reveal-on [data-reveal] {
          opacity: 0;
          transform: translateY(30px);
          transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
          will-change: opacity, transform;
        }
        html.reveal-on [data-reveal].is-visible {
          opacity: 1;
          transform: none;
        }
      }
      /* Smooth, consistent interactive transitions site-wide */
      a, button {
        transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.25s ease, transform 0.2s ease;
      }
    </style>
  </head>
  <body class={`bg-white text-ink-900 font-sans antialiased${skinClass}`}>
    {site.business.isDemo && (
      <div class="demo-banner bg-amber-100 border-b border-amber-300 text-amber-900 text-sm py-2 px-4 text-center">
        <strong>Demo website.</strong> This is a sample of what your business could have, not a real business.
      </div>
    )}
    <slot />

    <!-- Reveal each top-level section as it scrolls into view -->
    <script is:inline>
      (function () {
        if (!document.documentElement.classList.contains('reveal-on')) return;
        var els = [].slice.call(document.querySelectorAll('main > *'));
        els.forEach(function (el) { el.setAttribute('data-reveal', ''); });
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        els.forEach(function (el) { io.observe(el); });
        // Safety net: never leave content hidden if something goes wrong
        setTimeout(function () { els.forEach(function (el) { el.classList.add('is-visible'); }); }, 2500);
      })();
    </script>

    <!-- Assemble obfuscated contact links (see ../obfuscate.ts). The number
         never appears in the HTML source; it's built here from chunks so
         scraper bots can't harvest it. -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-k1]');
        Array.prototype.forEach.call(els, function (el) {
          var n = (el.getAttribute('data-k1') || '') + (el.getAttribute('data-k2') || '') + (el.getAttribute('data-k3') || '');
          if (!n) return;
          el.setAttribute('href', el.getAttribute('data-u') === 'w' ? 'https://wa.me/' + n : 'tel:' + n);
          var t = el.querySelector('[data-v]');
          var d1 = el.getAttribute('data-v1');
          if (t && d1 !== null) {
            t.textContent = d1 + (el.getAttribute('data-v2') || '') + (el.getAttribute('data-v3') || '');
          }
        });
      })();
    </script>
    {brandVars && <script is:inline set:html={BRAND_INK_JS}></script>}
  </body>
</html>
