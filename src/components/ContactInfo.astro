---
import type { SiteConfig } from '../schema';
import { bookingLink } from '../schema';
import Icon from './Icon.astro';
import { telAttrs, waAttrs } from '../obfuscate';
interface Props {
  site: SiteConfig;
}
const { site } = Astro.props;
const waNumber = site.contact.whatsapp?.replace(/\D/g, '');
const book = bookingLink(site);

// Factual coverage line — only states what the customer actually provided.
const c = site.contact;
const hasAddress = c.addressLines.length > 0;
const coverage = c.nationwide
  ? 'Covering all of the UK. Get in touch wherever you are.'
  : hasAddress && c.travelRadius
    ? `Based in ${c.addressLines.join(', ')}. Mobile appointments within ${c.travelRadius} miles.`
    : hasAddress
      ? `Based in ${c.addressLines.join(', ')}.`
      : c.travelRadius && c.serviceAreas[0]
        ? `Mobile service within ${c.travelRadius} miles of ${c.serviceAreas[0]}.`
        : c.serviceAreas[0]
          ? `Covering ${c.serviceAreas[0]}.`
          : '';

// The towns they actually cover, named, on the page where somebody is deciding
// whether to get in touch.
//
// The coverage line above says "within 15 miles", which is only useful to a
// reader who already knows how far away they live. The towns themselves were
// listed on the homepage and the About page but NOT here, which is the one page
// a person visits to answer "do you come to me?".
//
// The first area is skipped when it is already named in the line above, so a
// mobile business does not read "within 15 miles of Lichfield. Also covering
// Lichfield, Tamworth". Nothing is invented: this only ever lists towns the
// customer typed in.
const namedInCoverage = c.nationwide || (!!c.travelRadius && !hasAddress) ? 1 : 0;
const otherAreas = c.nationwide ? [] : c.serviceAreas.slice(namedInCoverage);
---

<aside class="space-y-5">
  <div class="rounded-2xl bg-brand-50 p-6 border border-brand-100">
    <h3 class="font-display font-bold text-ink-900 mb-3 flex items-center gap-2">
      <Icon name="phone" class="w-5 h-5 text-brand-600" /> Call us
    </h3>
    <a href="/contact" {...telAttrs(site.contact.phone, site.contact.phoneDisplay)} class="block text-2xl font-display font-extrabold text-brand-700 hover:underline">
      <span data-v>Tap to call</span>
    </a>
  </div>

  {book && (
    <div class="rounded-2xl bg-white p-6 border border-ink-100">
      <h3 class="font-display font-bold text-ink-900 mb-3 flex items-center gap-2">
        <Icon name="calendar" class="w-5 h-5 text-brand-600" /> Book online
      </h3>
      <p class="text-sm text-ink-700 mb-3">Pick a slot in our online booking system.</p>
      <a href={book.href} target={book.external ? '_blank' : undefined} rel={book.external ? 'noopener' : undefined} class="inline-flex items-center gap-2 rounded-full bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-5 py-2.5">
        Book a slot
      </a>
    </div>
  )}

  {site.contact.whatsapp && waNumber && (
    <div class="rounded-2xl bg-white p-6 border border-ink-100">
      <h3 class="font-display font-bold text-ink-900 mb-3 flex items-center gap-2">
        <Icon name="message-circle" class="w-5 h-5 text-brand-600" /> WhatsApp
      </h3>
      <a href="/contact" {...waAttrs(waNumber)} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-[#25D366] hover:bg-[#1ebd58] text-white text-sm font-semibold px-5 py-2.5">
        Message us on WhatsApp
      </a>
    </div>
  )}

  {site.contact.email && (
    <div class="rounded-2xl bg-white p-6 border border-ink-100">
      <h3 class="font-display font-bold text-ink-900 mb-3 flex items-center gap-2">
        <Icon name="mail" class="w-5 h-5 text-brand-600" /> Prefer to write?
      </h3>
      <p class="text-sm text-ink-700">Use the enquiry form on this page and your message lands straight in our inbox.</p>
    </div>
  )}

  {site.delivery && site.delivery.length > 0 && (
    <div class="rounded-2xl bg-white p-6 border border-ink-100">
      <h3 class="font-display font-bold text-ink-900 mb-3 flex items-center gap-2">
        <Icon name="bike" class="w-5 h-5 text-brand-600" /> Order online
      </h3>
      <div class="flex flex-wrap gap-2">
        {site.delivery.map((d) => (
          <a href={d.url} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-white border border-ink-200 hover:border-brand-300 text-ink-800 text-sm font-semibold px-4 py-2 transition-colors">
            {d.name} <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  )}

  {site.hours.length > 0 && (
  <div class="rounded-2xl bg-white p-6 border border-ink-100">
    <h3 class="font-display font-bold text-ink-900 mb-3 flex items-center gap-2">
      <Icon name="clock" class="w-5 h-5 text-brand-600" /> Opening hours
    </h3>
    <ul class="space-y-2 text-sm">
      {site.hours.map((row) => (
        <li class="flex justify-between text-ink-700">
          <span>{row.day}</span>
          <span class="font-medium text-ink-900">{row.hours}</span>
        </li>
      ))}
    </ul>
  </div>
  )}

  {coverage && (
  <div class="rounded-2xl bg-white p-6 border border-ink-100">
    <h3 class="font-display font-bold text-ink-900 mb-2 flex items-center gap-2">
      <Icon name="map-pin" class="w-5 h-5 text-brand-600" /> Where we work
    </h3>
    <p class="text-sm text-ink-700 leading-relaxed">
      {coverage}
    </p>
    {otherAreas.length > 0 && (
      <p class="mt-3 text-sm text-ink-700 leading-relaxed">
        <span class="font-semibold text-ink-900">Areas covered:</span> {otherAreas.join(', ')}.
      </p>
    )}
  </div>
  )}
</aside>
